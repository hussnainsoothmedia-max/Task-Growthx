---
import PageLayout from "../layouts/PageLayout.astro";
import { BUSINESS, SERVICES } from "../data/site";
import { caseStudies } from "../data/caseStudies";
---

<PageLayout
  title="About Hussnain Ahmad"
  heading="About Task GrowthX"
  eyebrow="About"
  path="/about/"
  type="AboutPage"
  description="Task GrowthX is run by Hussnain Ahmad, who builds n8n automation for dental clinics that want a calmer front desk and a fuller schedule."
>
  <section class="section cs-block" aria-labelledby="ab-who">
    <div class="wrap cs-grid">
      <div class="cs-side">
        <figure class="page-photo">
          <img src="/images/hussnain.png" alt="Hussnain Ahmad" width="256" height="256" />
        </figure>
      </div>
      <div class="cs-main prose">
        <h2 class="display-md" id="ab-who">Hi, I'm {BUSINESS.founder}.</h2>
        <p class="body-lg">I build AI automation for dental clinics. My work is the admin that fills every day at reception: answering booking requests, confirming appointments, chasing recalls and asking for reviews.</p>
        <p>Every workflow runs on n8n and open APIs, so your clinic owns it. I keep each build simple enough for your team to understand, test it before patients see it, and stay on after launch to monitor and improve it. If a simple fix beats an AI model, I will tell you.</p>
        <h3>How I work</h3>
        <ul>
          <li><b>Plain language.</b> Your team will understand what I build and how it works.</li>
          <li><b>Patient data first.</b> Each workflow only gets access to what it needs.</li>
          <li><b>You own it.</b> Workflows, accounts and documentation stay with your clinic.</li>
          <li><b>People stay in control.</b> Anything clinical or payment-related goes to a person.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section cs-block" aria-labelledby="ab-svc">
    <div class="wrap cs-grid">
      <div class="cs-side"><h2 class="display-md" id="ab-svc">What I build</h2></div>
      <div class="cs-main prose">
        <ul>{SERVICES.map((s) => <li><b>{s.name}.</b> {s.description}</li>)}</ul>
        <h3>Example builds</h3>
        <ul>{caseStudies.map((c) => <li><a href={`/work/${c.slug}/`}>{c.title}</a></li>)}</ul>
        <p><a class="btn btn--primary" href={BUSINESS.bookingUrl}>Book a discovery call <span class="arr" aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </section>
</PageLayout>
