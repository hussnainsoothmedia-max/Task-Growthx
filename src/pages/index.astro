---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Trust from "../components/Trust.astro";
import Problem from "../components/Problem.astro";
import Services from "../components/Services.astro";
import Work from "../components/Work.astro";
import Why from "../components/Why.astro";
import Process from "../components/Process.astro";
import About from "../components/About.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
import { faqPage, webPage } from "../data/schema";
import { BUSINESS, SITE_URL } from "../data/site";

const url = `${SITE_URL}/`;
const schema = [webPage(url, "Task GrowthX · AI Automation for Dental Clinics", BUSINESS.description), faqPage(url)];
---

<Layout schema={schema} markdown="/index.md">
  <a class="skip" href="#main">
    Skip to content
  </a>
  <Header />
  <main id="main">
    <Hero />
    <Trust />
    <Problem />
    <Services />
    <Work />
    <Why />
    <Process />
    <About />
    <Faq />
  </main>
  <Footer />
  <script src="../scripts/main.js"></script>
</Layout>
