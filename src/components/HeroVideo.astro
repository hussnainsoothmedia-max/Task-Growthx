---
// A looping "screen recording" of an n8n workflow running: a WhatsApp booking
// request arrives, each node executes, and the appointment is booked.
// Animated with GSAP in src/scripts/hero-video.js.
---

<div class="hv" id="hero-video">
  <div class="hv-bar">
    <div class="hv-title">
      <span class="hv-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>n8n · Patient booking</span>
    </div>
    <span class="hv-status" id="hv-status" role="status" aria-live="off">
      <i aria-hidden="true"></i><span>Waiting for message…</span>
    </span>
  </div>

  <div class="hv-stage">
    <svg viewBox="0 0 720 380" role="img" aria-labelledby="hv-t hv-d">
      <title id="hv-t">n8n booking workflow running</title>
      <desc id="hv-d">A patient asks on WhatsApp to book a cleaning. An AI agent reads the request, the workflow checks it is not urgent, finds open calendar slots, sends them to the patient, and books the chosen time in the practice software.</desc>
      <defs>
        <pattern id="hv-dots" width="18" height="18" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1.1" fill="#2b2b2b"></circle>
        </pattern>
      </defs>
      <rect width="720" height="380" fill="#151515"></rect>
      <rect width="720" height="380" fill="url(#hv-dots)"></rect>

      <!-- edges: grey base + green "run" overlay that fills when data passes -->
      <g class="hv-edges">
        <path class="hv-edge" d="M88 182 L140 182"></path>
        <path class="hv-edge" d="M296 182 L350 182"></path>
        <path class="hv-edge" d="M414 170 C444 170 440 82 470 82"></path>
        <path class="hv-edge" d="M414 194 C444 194 440 282 470 282"></path>
        <path class="hv-edge" d="M534 282 L610 282"></path>
        <path class="hv-edge hv-edge--sub" d="M190 218 L190 270"></path>
        <path class="hv-edge hv-edge--sub" d="M260 218 L260 270"></path>

        <path class="hv-run" id="hv-e1" d="M88 182 L140 182"></path>
        <path class="hv-run" id="hv-e2" d="M296 182 L350 182"></path>
        <path class="hv-run" id="hv-e3" d="M414 194 C444 194 440 282 470 282"></path>
        <path class="hv-run" id="hv-e4" d="M534 282 L610 282"></path>
      </g>

      <!-- edge labels -->
      <text class="hv-elabel" x="434" y="122">urgent</text>
      <text class="hv-elabel hv-elabel--route" id="hv-route" x="434" y="250">routine</text>
      <g class="hv-chip" id="hv-chip1" transform="translate(94 160)"><rect width="42" height="16" rx="8"></rect><text x="21" y="11.5">1 item</text></g>
      <g class="hv-chip" id="hv-chip2" transform="translate(272 132)"><rect width="104" height="16" rx="8"></rect><text x="52" y="11.5">cleaning · routine</text></g>
      <g class="hv-chip" id="hv-chip3" transform="translate(538 260)"><rect width="68" height="16" rx="8"></rect><text x="34" y="11.5">Tue 09:30</text></g>

      <!-- nodes -->
      <g class="hv-node" id="hv-n1" transform="translate(24 150)">
        <path class="box" d="M32 0 H56 Q64 0 64 8 V56 Q64 64 56 64 H32 A32 32 0 0 1 32 0 Z"></path>
        <path class="ic" d="M22 22 h20 a4 4 0 0 1 4 4 v9 a4 4 0 0 1 -4 4 h-11 l-6 5 v-5 h-3 a4 4 0 0 1 -4 -4 v-9 a4 4 0 0 1 4 -4 z"></path>
        <circle class="spin" cx="58" cy="6" r="7"></circle>
        <g class="ok" transform="translate(58 6)"><circle r="8"></circle><path d="M-3.5 0 l2.5 2.5 l4.5 -5"></path></g>
        <text class="lbl" x="32" y="86">WhatsApp</text>
        <text class="sub" x="32" y="101">trigger</text>
      </g>

      <g class="hv-node hv-node--ai" id="hv-n2" transform="translate(140 146)">
        <rect class="box" width="156" height="72" rx="10"></rect>
        <path class="ic" d="M28 22 l3.5 9.5 l9.5 3.5 l-9.5 3.5 l-3.5 9.5 l-3.5 -9.5 l-9.5 -3.5 l9.5 -3.5 z"></path>
        <text class="in-t" x="52" y="33">AI Agent</text>
        <text class="in-s" x="52" y="50">read request</text>
        <circle class="spin" cx="150" cy="6" r="7"></circle>
        <g class="ok" transform="translate(150 6)"><circle r="8"></circle><path d="M-3.5 0 l2.5 2.5 l4.5 -5"></path></g>
      </g>
      <g class="hv-subnode" id="hv-s1" transform="translate(190 292)">
        <circle r="22"></circle><text class="g" y="5">AI</text>
        <text class="lbl" y="40">Chat model</text>
      </g>
      <g class="hv-subnode" id="hv-s2" transform="translate(260 292)">
        <circle r="22"></circle><text class="g" y="5">M</text>
        <text class="lbl" y="40">Memory</text>
      </g>

      <g class="hv-node" id="hv-n3" transform="translate(350 150)">
        <rect class="box" width="64" height="64" rx="10"></rect>
        <path class="ic" d="M20 20 v8 a6 6 0 0 0 6 6 h12 a6 6 0 0 1 6 6 v4 M20 28 v16 M44 20 v4"></path>
        <circle class="spin" cx="58" cy="6" r="7"></circle>
        <g class="ok" transform="translate(58 6)"><circle r="8"></circle><path d="M-3.5 0 l2.5 2.5 l4.5 -5"></path></g>
        <text class="lbl" x="32" y="86">Urgent?</text>
        <text class="sub" x="32" y="101">if</text>
      </g>

      <g class="hv-node hv-node--idle" id="hv-n4" transform="translate(470 50)">
        <rect class="box" width="64" height="64" rx="10"></rect>
        <path class="ic" d="M32 18 v16 M32 42 v2"></path>
        <text class="lbl" x="32" y="86">Alert desk</text>
        <text class="sub" x="32" y="101">same-day hold</text>
      </g>

      <g class="hv-node" id="hv-n5" transform="translate(470 250)">
        <rect class="box" width="64" height="64" rx="10"></rect>
        <path class="ic" d="M19 22 h26 v22 h-26 z M19 29 h26 M25 18 v7 M39 18 v7"></path>
        <circle class="spin" cx="58" cy="6" r="7"></circle>
        <g class="ok" transform="translate(58 6)"><circle r="8"></circle><path d="M-3.5 0 l2.5 2.5 l4.5 -5"></path></g>
        <text class="lbl" x="32" y="86">Find slots</text>
        <text class="sub" x="32" y="101">calendar</text>
      </g>

      <g class="hv-node" id="hv-n6" transform="translate(610 250)">
        <rect class="box" width="64" height="64" rx="10"></rect>
        <path class="ic" d="M20 22 h24 v22 h-24 z M26 33 l4 4 l8 -8"></path>
        <circle class="spin" cx="58" cy="6" r="7"></circle>
        <g class="ok" transform="translate(58 6)"><circle r="8"></circle><path d="M-3.5 0 l2.5 2.5 l4.5 -5"></path></g>
        <text class="lbl" x="32" y="86">Book in PMS</text>
        <text class="sub" x="32" y="101">confirm</text>
      </g>

      <!-- WhatsApp conversation -->
      <text class="hv-chat-cap" x="24" y="20">Patient · WhatsApp</text>
      <g transform="translate(24 28)"><g class="hv-msg hv-msg--in" id="hv-m1">
        <rect width="246" height="28" rx="10"></rect>
        <text x="12" y="18.5">Hi! Can I book a cleaning next week?</text>
      </g></g>
      <g transform="translate(64 62)"><g class="hv-msg hv-msg--out" id="hv-m2">
        <rect width="290" height="28" rx="10"></rect>
        <text x="12" y="18.5">Sure! Open slots: Tue 09:30 or Wed 14:00</text>
      </g></g>
      <g transform="translate(24 96)"><g class="hv-msg hv-msg--in" id="hv-m3">
        <rect width="128" height="28" rx="10"></rect>
        <text x="12" y="18.5">Tue 09:30 please</text>
      </g></g>
    </svg>
  </div>

  <div class="hv-controls">
    <button class="hv-play" id="hv-play" type="button" aria-label="Pause workflow video" aria-pressed="false">
      <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3" y="2" width="3.5" height="12" rx="1"></rect><rect x="9.5" y="2" width="3.5" height="12" rx="1"></rect></svg>
      <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5 L13 8 L4 13.5 Z"></path></svg>
    </button>
    <div class="hv-track" aria-hidden="true"><b id="hv-progress"></b></div>
    <span class="hv-time mono" id="hv-time" aria-hidden="true">0:00 / 0:09</span>
  </div>
  <p class="hv-foot mono" id="hv-foot">Execution #1042 · sample data</p>
</div>

<script>
  import "../scripts/hero-video.js";
</script>
