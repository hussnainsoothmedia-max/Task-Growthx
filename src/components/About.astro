---
import { CAL_URL } from "../config";
---

<section class="section services" id="about" aria-labelledby="about-h">
  <div class="wrap">
    <div class="about-grid">
      <div class="about-copy">
        <span class="eyebrow">About me</span>
        <h2 class="display-lg" id="about-h">Hi, I'm Hussnain Ahmad.</h2>
        <p class="subhead">I build AI automation for dental clinics that want a calmer front desk and a fuller schedule.</p>
        <p class="muted">I build n8n automations that take repetitive admin off a clinic's front desk: answering booking requests, confirming appointments, chasing recalls and asking for reviews. Every workflow stays simple enough for your team to understand. I would rather build one workflow your team trusts for years than ten experiments that need babysitting, and if a simple fix beats an AI model, I will tell you.</p>
        <ul class="me-skills">
          <li class="chip">n8n workflows</li>
          <li class="chip">AI agents</li>
          <li class="chip">WhatsApp automation</li>
          <li class="chip">WordPress</li>
        </ul>
        <a class="btn btn--primary" href={CAL_URL}>Book a call with me <span class="arr" aria-hidden="true">&rarr;</span></a>
      </div>

      <figure class="me-photo">
        <img src="/images/hussnain.png" alt="Hussnain Ahmad" width="256" height="120" loading="lazy" decoding="async" />
        <span class="me-tag"><i aria-hidden="true"></i>Built on n8n</span>
      </figure>
    </div>
  </div>
</section>
