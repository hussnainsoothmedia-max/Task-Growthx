---
import { CAL_URL } from "../config";
import { BUSINESS } from "../data/site";
const { base = "" } = Astro.props;

// "https://www.linkedin.com/in/x" -> "LinkedIn"
const NAMES: Record<string, string> = {
  linkedin: "LinkedIn", instagram: "Instagram", youtube: "YouTube", github: "GitHub",
  x: "X", twitter: "X", facebook: "Facebook", upwork: "Upwork", tiktok: "TikTok", fiverr: "Fiverr",
};
const label = (u: string) => {
  const host = new URL(u).hostname.replace(/^www\./, "").split(".")[0];
  return NAMES[host] ?? host.charAt(0).toUpperCase() + host.slice(1);
};
---
<footer class="footer" aria-labelledby="foot-h">
  <div class="wrap">
    <h2 id="foot-h" class="skip">Footer</h2>
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="foot-logo" href={base + "#hero"}>
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span>Hussnain Ahmad</span>
        </a>
        <p>AI automation for dental clinics: online booking, reminders, recalls and front-desk workflows, built on n8n.</p>
      </div>
      <div class="foot-col">
        <h4>Navigation</h4>
        <ul><li><a href={base + "#hero"}>Home</a></li><li><a href="/about/">About</a></li><li><a href={base + "#services"}>Services</a></li><li><a href={base + "#process"}>Process</a></li><li><a href={base + "#work"}>Selected work</a></li><li><a href="/contact/">Contact</a></li></ul>
      </div>
      <div class="foot-col">
        <h4>Services</h4>
        <ul><li><a href={base + "#services"}>Online booking</a></li><li><a href={base + "#services"}>Reminders &amp; no-shows</a></li><li><a href={base + "#services"}>Recall &amp; reactivation</a></li><li><a href={base + "#services"}>AI front-desk assistant</a></li></ul>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <ul>
          <li><a href={CAL_URL}>Book a discovery call</a></li>
          {BUSINESS.email && <li><a href={`mailto:${BUSINESS.email}`}>{BUSINESS.email}</a></li>}
          {BUSINESS.phone && <li><a href={`tel:${BUSINESS.phone}`}>{BUSINESS.phone}</a></li>}
          <li><a href="/contact/">Contact page</a></li>
          {BUSINESS.sameAs.map((u) => <li><a href={u} rel="me noopener" target="_blank">{label(u)}</a></li>)}
        </ul>
      </div>
    </div>
    <p class="foot-word" aria-hidden="true">Hussnain<span>.</span></p>
    <div class="foot-base">
      <span>&copy; 2026 Hussnain Ahmad. All rights reserved.</span>
      <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
    </div>
  </div>
</footer>
