---
import { CAL_URL } from "../config";
---
<footer class="footer" aria-labelledby="foot-h">
  <div class="wrap">
    <h2 id="foot-h" class="skip">Footer</h2>
    <div class="foot-grid">
      <div class="foot-brand">
        <svg class="logo" viewBox="0 0 336.3 64" role="img" aria-label="Hussnain Ahmad" style="height:32px"><use href="#tgx-logo"></use></svg>
        <p>AI automation for dental clinics: online booking, reminders, recalls and front-desk workflows, built on n8n.</p>
      </div>
      <div class="foot-col">
        <h4>Navigation</h4>
        <ul><li><a href="#hero">Home</a></li><li><a href="#about">About</a></li><li><a href="#services">Services</a></li><li><a href="#process">Process</a></li><li><a href="#work">Selected work</a></li></ul>
      </div>
      <div class="foot-col">
        <h4>Services</h4>
        <ul><li><a href="#services">Online booking</a></li><li><a href="#services">Reminders &amp; no-shows</a></li><li><a href="#services">Recall &amp; reactivation</a></li><li><a href="#services">AI front-desk assistant</a></li></ul>
      </div>
      <div class="foot-col">
        <h4>Contact</h4>
        <ul><li><a href={CAL_URL}>Book a discovery call</a></li><li><a href="#" data-placeholder>LinkedIn</a></li><li><a href="#" data-placeholder>Instagram</a></li><li><a href="#" data-placeholder>YouTube</a></li></ul>
      </div>
    </div>
    <p class="foot-word" aria-hidden="true">Hussnain Ahmad<span>.</span></p>
    <div class="foot-base">
      <span>&copy; 2026 Hussnain Ahmad. All rights reserved.</span>
      <span>Built on n8n. Tested before launch.</span>
    </div>
  </div>
</footer>
