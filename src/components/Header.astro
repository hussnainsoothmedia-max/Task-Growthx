---
import { CAL_URL } from "../config";
const { base = "" } = Astro.props;
---
<header class="nav-shell" id="top">
  <div class="wrap">
    <nav class="nav" aria-label="Main">
      <a class="nav-brand" href={base + "#hero"} aria-label="Hussnain Ahmad home">
        <svg
          class="logo"
          viewBox="0 0 336.3 64"
          role="img"
          aria-label="Hussnain Ahmad"
        >
          <use href="#tgx-logo"></use>
        </svg>
      </a>
      <ul class="nav-links">
        <li><a href={base + "#hero"} data-sec="hero">Home</a></li>
        <li><a href={base + "#services"} data-sec="services">Services</a></li>
        <li><a href={base + "#process"} data-sec="process">Process</a></li>
        <li><a href={base + "#about"} data-sec="about">About</a></li>
      </ul>
      <div class="nav-actions">
        <a class="btn btn--primary" href={CAL_URL}
          >Book a discovery call
          <span class="arr" aria-hidden="true">&rarr;</span></a
        >
        <button
          class="menu-btn"
          id="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <span></span>
        </button>
      </div>
    </nav>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <ul>
        <li><a href={base + "#hero"}>Home</a></li>
        <li><a href={base + "#about"}>About</a></li>
        <li><a href={base + "#services"}>Services</a></li>
        <li><a href={base + "#process"}>Process</a></li>
        <li><a href={base + "#contact"}>Contact</a></li>
      </ul>
      <a class="btn btn--primary" href={CAL_URL}>Book a discovery call</a>
    </div>
  </div>
</header>
