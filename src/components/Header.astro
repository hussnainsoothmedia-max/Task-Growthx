---
import { CAL_URL } from "../config";
const { base = "" } = Astro.props;

// Menu items in page order. `sec` links to a homepage section; `href` to a page.
const items = [
  { label: "Home", sec: "hero" },
  { label: "Services", sec: "services" },
  { label: "Work", sec: "work" },
  { label: "Why us", sec: "why" },
  { label: "Process", sec: "process" },
  { label: "About", sec: "about" },
  { label: "FAQ", sec: "faq" },
  { label: "Blog", href: "/blog/" },
];
const path = Astro.url.pathname;
const link = (it: (typeof items)[number]) => (it.href ? it.href : base + "#" + it.sec);
const current = (it: (typeof items)[number]) => (it.href && path.startsWith(it.href) ? "page" : undefined);
---
<header class="nav-shell" id="top">
  <div class="wrap">
    <nav class="nav" aria-label="Main">
      <a class="nav-brand" href={base + "#hero"} aria-label="Hussnain Ahmad home">
        <svg
          class="logo"
          viewBox="0 0 380 64"
          role="img"
          aria-label="Hussnain Ahmad"
        >
          <use href="#tgx-logo"></use>
        </svg>
      </a>
      <ul class="nav-links">
        {items.map((it) => (
          <li><a href={link(it)} data-sec={it.sec} aria-current={current(it)}>{it.label}</a></li>
        ))}
      </ul>
      <div class="nav-actions">
        <a class="btn btn--primary" href={CAL_URL}
          >Book a discovery call
          <span class="arr" aria-hidden="true">&rarr;</span></a
        >
        <button
          class="menu-btn"
          id="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <span></span>
        </button>
      </div>
    </nav>
    <div class="mobile-menu" id="mobile-menu" hidden>
      <ul>
        {items.map((it) => <li><a href={link(it)} aria-current={current(it)}>{it.label}</a></li>)}
        <li><a href="/contact/">Contact</a></li>
      </ul>
      <a class="btn btn--primary" href={CAL_URL}>Book a discovery call</a>
    </div>
  </div>
</header>
