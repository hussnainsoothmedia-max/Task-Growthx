      <article class="project rv">
        <div class="project-meta"><span class="badge badge--line">Demo build</span><span class="badge badge--neutral">Multi-chair clinic</span></div>
        <div class="preview" aria-hidden="true">
          <div class="mini-flow">
            <div class="node"><b>Appointment</b><span class="mono">T-48h</span></div><span class="arrow">&rarr;</span>
