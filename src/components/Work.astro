---
import { caseStudies } from "../data/caseStudies";
import "../styles/work.css";
---

<section class="section" id="work" aria-labelledby="work-h">
  <div class="wrap">
    <div class="section-head">
      <div class="stack">
        <span class="eyebrow">Selected work</span>
        <h2 class="display-lg" id="work-h">Systems we've built. Processes we've improved.</h2>
      </div>
      <p class="body-lg muted">Example builds that show how we approach common clinic problems. Each one is a demonstration project, not a client case study.</p>
    </div>

    <div class="work-grid">
      {caseStudies.map((cs, i) => {
        const wide = i === 0;
        const shot = (
          <a class="project-shot" href={`/work/${cs.slug}/`} tabindex="-1" aria-hidden="true">
            <img src={cs.image} alt="" width="1200" height="560" loading="lazy" decoding="async" />
          </a>
        );
        const body = (
          <>
            <div class="project-meta">
              <span class="badge badge--line">Demo build</span>
              <span class="badge badge--neutral">{cs.clinic}</span>
            </div>
            <h3>{cs.title}</h3>
            <dl>
              <div><dt>Challenge</dt><dd>{cs.challenge}</dd></div>
              <div><dt>Automation solution</dt><dd>{cs.solution}</dd></div>
            </dl>
            <a class="case-link" href={`/work/${cs.slug}/`}>
              View case study <span class="visually-hidden">: {cs.title}</span>
              <span class="arr" aria-hidden="true">&rarr;</span>
            </a>
          </>
        );
        return wide ? (
          <article class="project project--wide rv">
            <div class="copy">{body}</div>
            {shot}
          </article>
        ) : (
          <article class="project rv">
            {shot}
            {body}
          </article>
        );
      })}
    </div>
    <p class="demo-note">These are demonstration projects built to show our approach for dental clinics. They are not presented as client results. Ask us on a call and we will walk you through a live build.</p>
    <div class="work-more">
      <a class="btn btn--secondary" href="/work/">View all work <span class="arr" aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
</section>
