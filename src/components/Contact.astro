---
import { CAL_URL } from "../config";
---
<section class="section" id="contact" aria-labelledby="cta-h" style="padding-top:0">
  <div class="wrap">
    <div class="cta-card rv">
      <div class="cta-copy">
        <span class="eyebrow">Book a discovery call</span>
        <h2 class="display-lg" id="cta-h">Ready to make your clinic work smarter?</h2>
        <p class="body-lg muted">Let's find the tasks slowing your front desk down and build systems that keep your schedule full.</p>
        <ul>
          <li>A 30-minute call, no preparation needed</li>
          <li>We map one clinic workflow worth automating</li>
          <li>You leave with a clear next step, whether or not we work together</li>
        </ul>
      </div>
      <div class="form-slot">
      <form class="form" id="contact-form" data-cal-url={CAL_URL} novalidate>
        <div class="field">
          <label class="label" for="f-name">Your name</label>
          <input class="input" id="f-name" name="name" type="text" autocomplete="name" placeholder="Jane Doe" required>
        </div>
        <div class="field">
          <label class="label" for="f-email">Clinic email</label>
          <input class="input" id="f-email" name="email" type="email" autocomplete="email" placeholder="you@yourclinic.com" required>
          <span class="err" id="f-email-err" hidden>Enter an email address like name@yourclinic.com.</span>
        </div>
        <div class="field">
          <label class="label" for="f-task">What should we automate first?</label>
          <textarea class="input" id="f-task" name="task" placeholder="e.g. online booking, appointment reminders, recalls"></textarea>
        </div>
        <button class="btn btn--primary" type="submit">Book a discovery call <span class="arr" aria-hidden="true">&rarr;</span></button>
        <p class="form-note">You'll pick a time on our booking page. Your details are filled in for you.</p>
      </form>
      <div class="form-done" id="form-done" hidden>
        <h3 class="card-title" style="margin:0" id="done-h">Thanks.</h3>
        <p class="muted">Taking you to our booking page to pick a time. <a href={CAL_URL}>Open it now</a> if it doesn't load.</p>
        <button class="btn btn--secondary" type="button" id="form-reset">Edit details</button>
      </div>
      </div>
    </div>
  </div>
</section>
