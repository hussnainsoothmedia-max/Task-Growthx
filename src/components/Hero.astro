---
import HeroVideo from "./HeroVideo.astro";
---

<section class="hero" id="hero" aria-labelledby="hero-h">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow rv">AI automation for dental clinics</span>
        <h1 class="display-xl rv" id="hero-h">AI systems that keep dental chairs full.</h1>
        <p class="body-lg muted rv">We automate patient booking, reminders, recalls and follow-ups, so your front desk can focus on the patients in the room.</p>
        <div class="cta-row rv">
          <a class="btn btn--primary" href="#contact">Let's talk <span class="arr" aria-hidden="true">&rarr;</span></a>
          <a class="btn btn--secondary" href="#services">Explore our services</a>
        </div>
      </div>

      <figure class="hero-visual rv" style="margin:0">
        <HeroVideo />
      </figure>
    </div>

    <div class="facts">
      <div><b>Built on n8n and open APIs</b><span>Your clinic owns the workflows. No black boxes.</span></div>
      <div><b>Works with your practice software</b><span>We connect your schedule, phones and messages instead of replacing them.</span></div>
      <div><b>Your team stays in control</b><span>Anything clinical or payment-related goes to a person.</span></div>
      <div><b>Tested before patients see it</b><span>Error handling and alerts in every build.</span></div>
    </div>
  </div>
</section>
